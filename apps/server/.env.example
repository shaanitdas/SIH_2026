# SIH PrivacyGuard planner server — environment configuration.
# Copy to `.env` and adjust. The server does not load .env files automatically;
# use `docker compose --env-file` or your process manager to export these.

# Bind address (0.0.0.0 listens on all interfaces, including ::1, so the
# extension's "http://localhost:8080" default always resolves. Keep it that
# way for dev; front it with a reverse proxy + TRUST_PROXY=true in production).
HOST=0.0.0.0

# HTTP port.
PORT=8080

# Allowed CORS origin. "*" allows any origin (extension content scripts fetch
# cross-origin). Set a specific origin (e.g. https://your-browser-agent.app) for production.
CORS_ORIGIN=*

# Max requests per IP per 60 s window.
RATE_LIMIT_MAX=120

# Set to "true" when the API sits behind a reverse proxy (nginx, Traefik, ...)
# so rate-limiter keys and logs use the X-Forwarded-For client IP.
TRUST_PROXY=false

# "info" enables structured JSON access logs; "silent" disables them.
LOG_LEVEL=info

# --- Optional LLM planner (OpenAI-compatible chat-completions) ---
# When unset, the deterministic planner is used (always available).
PLANNER_API_KEY=
# OPENAI_API_KEY=             # fallback alias for PLANNER_API_KEY
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini