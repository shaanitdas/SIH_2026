# SIH PrivacyGuard — repository root environment example.
# Placed here for discoverability; the planner server reads the variables below.
# See apps/server/.env.example for the full annotated set.

HOST=127.0.0.1
PORT=8080
CORS_ORIGIN=*
RATE_LIMIT_MAX=120
TRUST_PROXY=false
LOG_LEVEL=info

# Optional LLM planner.
PLANNER_API_KEY=
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4o-mini